# Dockerfile.debian13.node22
FROM container-forge/debian13-slim:latest
 
ENV DEBIAN_FRONTEND=noninteractive
 
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    python3 \
    python3-pip \
    build-essential \
    git \
    xz-utils \
    yarnpkg \
    yq \
    && rm -rf /var/lib/apt/lists/*
 
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get update \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*
 
# Corepack intentionally NOT enabled. Enabling it installs shims for
# yarn/yarnpkg/pnpm/pnpx into /usr/local/bin, which resolves ahead of
# /usr/bin on PATH — so those shims silently shadow the apt-installed,
# dpkg-tracked yarnpkg above, and any build step that invokes yarn (by
# either name) ends up routed through Corepack instead. Corepack then
# tries to fetch whatever package-manager version a project's
# package.json happens to pin from the network (repo.yarnpkg.com),
# which is both a network dependency this pipeline can't rely on and a
# source of version drift outside local-repo/dpkg provenance. Keeping
# Corepack off means yarn/yarnpkg always resolve to the one real,
# signed, locally-repo'd package installed above — deterministic
# across every build that uses this image.
 
# Symlink yarn -> yarnpkg: Debian packages the classic Yarn CLI as
# `yarnpkg` (the `yarn` name collides with an unrelated Debian
# package), but some projects' build tooling invokes the bare `yarn`
# command. This makes both names resolve to the same real binary.
RUN ln -sf /usr/bin/yarnpkg /usr/bin/yarn
 
WORKDIR /src
