{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "uid": "pipeline-status",
  "title": "Nucleus Pipeline Status",
  "description": "Build, sync, package and vulnerability status for the Debian 13 image pipeline. Fed by emit_event.sh via node_exporter textfile collector.",
  "tags": [
    "pipeline",
    "containers"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "severity",
        "label": "Severity (over-time panels)",
        "type": "custom",
        "query": "Critical,High,Medium,Low,Negligible",
        "multi": false,
        "includeAll": false,
        "options": [
          {
            "text": "Critical",
            "value": "Critical",
            "selected": false
          },
          {
            "text": "High",
            "value": "High",
            "selected": true
          },
          {
            "text": "Medium",
            "value": "Medium",
            "selected": false
          },
          {
            "text": "Low",
            "value": "Low",
            "selected": false
          },
          {
            "text": "Negligible",
            "value": "Negligible",
            "selected": false
          }
        ],
        "current": {
          "selected": true,
          "text": "High",
          "value": "High"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Base image builds (container-forge, daily 0500)",
      "description": "Result of the last build of each base image.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "pipeline_last_status{type=\"build\"} or on(target) label_replace(vector(-1), \"target\", \"debian13-base\", \"\", \"\") or on(target) label_replace(vector(-1), \"target\", \"debian13-go\", \"\", \"\") or on(target) label_replace(vector(-1), \"target\", \"debian13-node20\", \"\", \"\") or on(target) label_replace(vector(-1), \"target\", \"debian13-node22\", \"\", \"\") or on(target) label_replace(vector(-1), \"target\", \"debian13-postgres18\", \"\", \"\")",
          "instant": true,
          "range": false,
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "✔ OK",
                  "color": "#0ca30c",
                  "index": 0
                },
                "0": {
                  "text": "✖ FAILED",
                  "color": "#d03b3b",
                  "index": 1
                },
                "-1": {
                  "text": "… NOT REPORTING YET",
                  "color": "#fab219",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "no data yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Base image syncs (ansible-forge, daily 0600)",
      "description": "Result of the last sync/load of each base image. A 'setup' tile (GPG key / quarter step) appears only if that step fails.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "pipeline_last_status{type=\"sync\",target!=\"setup\"} or (pipeline_last_status{type=\"sync\",target=\"setup\"} == 0) or on(target) label_replace(vector(-1), \"target\", \"debian13-base\", \"\", \"\") or on(target) label_replace(vector(-1), \"target\", \"debian13-go\", \"\", \"\") or on(target) label_replace(vector(-1), \"target\", \"debian13-node20\", \"\", \"\") or on(target) label_replace(vector(-1), \"target\", \"debian13-node22\", \"\", \"\") or on(target) label_replace(vector(-1), \"target\", \"debian13-postgres18\", \"\", \"\")",
          "instant": true,
          "range": false,
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "✔ OK",
                  "color": "#0ca30c",
                  "index": 0
                },
                "0": {
                  "text": "✖ FAILED",
                  "color": "#d03b3b",
                  "index": 1
                },
                "-1": {
                  "text": "… NOT REPORTING YET",
                  "color": "#fab219",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "no data yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Trixie package builds (weekly, Wednesday)",
      "description": "Result of the last weekly nginx / openssl package job on Trixie.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "pipeline_last_status{type=\"repo\"} or on(target) label_replace(vector(-1), \"target\", \"nginx\", \"\", \"\") or on(target) label_replace(vector(-1), \"target\", \"openssl\", \"\", \"\")",
          "instant": true,
          "range": false,
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "✔ OK",
                  "color": "#0ca30c",
                  "index": 0
                },
                "0": {
                  "text": "✖ FAILED",
                  "color": "#d03b3b",
                  "index": 1
                },
                "-1": {
                  "text": "… NOT REPORTING YET",
                  "color": "#fab219",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "no data yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Base image in sync?",
      "description": "Green when container-forge's build digest equals the digest ansible-forge synced. Red if they differ, or if either side hasn't reported (or a failed run reported no digest).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(count by (target) (pipeline_info{type=~\"build|sync\", target=~\"debian13-.+\"}) == bool 2) * (count by (target) (count by (target, version) (pipeline_info{type=~\"build|sync\", target=~\"debian13-.+\"})) == bool 1) or on(target) label_replace(vector(0), \"target\", \"debian13-base\", \"\", \"\") or on(target) label_replace(vector(0), \"target\", \"debian13-go\", \"\", \"\") or on(target) label_replace(vector(0), \"target\", \"debian13-node20\", \"\", \"\") or on(target) label_replace(vector(0), \"target\", \"debian13-node22\", \"\", \"\") or on(target) label_replace(vector(0), \"target\", \"debian13-postgres18\", \"\", \"\")",
          "instant": true,
          "range": false,
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "✔ IN SYNC",
                  "color": "#0ca30c",
                  "index": 0
                },
                "0": {
                  "text": "✖ DIFFERENT / MISSING",
                  "color": "#d03b3b",
                  "index": 1
                },
                "-1": {
                  "text": "… NOT REPORTING YET",
                  "color": "#fab219",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "no data yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "How overdue is each job?  (1.0 = one full expected interval since last run)",
      "description": "Time since the job last ran, divided by how often it should run. Daily jobs use 24h, weekly jobs 7 days. Amber past 1.25, red past 2.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(time() - pipeline_last_run_timestamp_seconds{target!=\"setup\"}) / (pipeline_expected_interval_seconds{target!=\"setup\"} > 0)",
          "instant": true,
          "range": false,
          "legendFormat": "{{type}} / {{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "max": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1.25
              },
              {
                "color": "#d03b3b",
                "value": 2
              }
            ]
          },
          "noValue": "no data yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Time since last successful run",
      "description": "For a job that is currently failing, this is how long ago it last worked.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(time() - pipeline_last_success_timestamp_seconds{target!=\"setup\"}) and (pipeline_last_success_timestamp_seconds{target!=\"setup\"} > 0)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "Value": "Since last success",
              "type": "Step",
              "target": "Target",
              "host": "Host"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no data yet"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Since last success"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Since last success",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Trixie package versions",
      "description": "'repo' = newest upstream version seen on the last weekly run. 'repo-new' = version of the last package that was actually built.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "pipeline_info{type=~\"repo|repo-new\"}",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "host": true,
              "Value": true
            },
            "renameByName": {
              "type": "Kind",
              "target": "Package",
              "version": "Version"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no data yet"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Last new package built",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 14,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "pipeline_last_run_timestamp_seconds{type=\"repo-new\"} * 1000",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "host": true,
              "type": true
            },
            "renameByName": {
              "target": "Package",
              "Value": "Built"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no new package built yet"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Built"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Vulnerabilities by image - ccop (latest scan)",
      "description": "Findings from each image's most recent scan. One row per image; images are never added together.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (image, severity) (image_vulns{image=~\"ccop/.+\"})",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "image",
            "columnField": "severity",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "image\\severity": "Image"
            },
            "indexByName": {
              "image\\severity": 0,
              "Critical": 1,
              "High": 2,
              "Medium": 3,
              "Low": 4,
              "Negligible": 5,
              "Unknown": 6
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no scan data yet",
          "decimals": 0,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "High"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ec835a"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Medium"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#fab219"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Low"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8b8b85"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Vulnerabilities by image - nucleus (latest scan)",
      "description": "Findings from each image's most recent scan. One row per image; images are never added together.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (image, severity) (image_vulns{image=~\"nucleus/.+\"})",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "image",
            "columnField": "severity",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "image\\severity": "Image"
            },
            "indexByName": {
              "image\\severity": 0,
              "Critical": 1,
              "High": 2,
              "Medium": 3,
              "Low": 4,
              "Negligible": 5,
              "Unknown": 6
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no scan data yet",
          "decimals": 0,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
